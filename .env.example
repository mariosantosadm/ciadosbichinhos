# Copie este arquivo para .env (nunca comitado) e preencha os valores.
# Ver instruções de como obter cada credencial no README ou pedir ao Claude Code.

# Search Console + GA4 (Google) — a mesma conta de serviço pode atender as duas,
# desde que seja adicionada como usuária em ambas.
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=
GSC_SITE_URL=
GA4_PROPERTY_ID=

# Cloudflare Web Analytics (API GraphQL)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
