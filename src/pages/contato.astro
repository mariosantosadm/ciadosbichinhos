---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contato" description="Fale com o Cia dos Bichinhos.">
  <div class="container page">
    <h1>Contato</h1>
    <p>
      Dúvidas, sugestões de pauta ou proposta de parceria? Escreva pra gente em
      <a href="mailto:contato@ciadosbichinhos.com.br">contato@ciadosbichinhos.com.br</a>.
    </p>
  </div>
</BaseLayout>

<style>
  .page {
    max-width: 720px;
    padding-block: 3rem;
  }
</style>
