---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sidebar from '../../components/Sidebar.astro';
import PostCard from '../../components/PostCard.astro';
import { categories, categoryList } from '../../lib/categories';

export async function getStaticPaths() {
  return categoryList.map((cat) => ({ params: { slug: cat.slug } }));
}

const { slug } = Astro.params;
const cat = categories[slug as keyof typeof categories];

const allPosts = await getCollection('blog');

const isSpeciesPage = cat.slug === 'cachorro' || cat.slug === 'gato';

const categoryPosts = allPosts
  .filter((post) =>
    isSpeciesPage
      ? post.data.species === cat.slug || post.data.species === 'ambos'
      : post.data.category === cat.slug || post.data.alsoIn.includes(cat.slug)
  )
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title={`${cat.label}: dicas e cuidados`} description={cat.metaDescription}>
  <div class="container category-header">
    <h1>{cat.label}</h1>
    <p class="category-header__descriptor">{cat.descriptor}</p>
    <div class="ad-slot">Espaço publicitário</div>
  </div>

  <div class="container category-layout">
    <section class="category-feed">
      {categoryPosts.length === 0 && <p>Ainda não temos posts nesta categoria. Volte em breve!</p>}

      <div class="category-feed__grid">
        {categoryPosts.map((post) => <PostCard post={post} />)}
      </div>
    </section>

    <Sidebar posts={allPosts} />
  </div>
</BaseLayout>

<style>
  .category-header {
    padding-top: 2.5rem;
  }

  .category-header__descriptor {
    color: #4a564d;
    font-size: 1.05rem;
  }

  .category-layout {
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: 2.5rem;
    padding-bottom: 3rem;
    align-items: start;
  }

  .category-feed__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  @media (max-width: 860px) {
    .category-layout {
      grid-template-columns: 1fr;
    }

    .category-feed__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
