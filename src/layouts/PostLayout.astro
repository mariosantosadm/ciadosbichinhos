---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';
import AffiliateBox from '../components/AffiliateBox.astro';
import PostCard from '../components/PostCard.astro';
import { categories } from '../lib/categories';
import { readingTime } from '../lib/reading-time';
import { getRelatedPosts } from '../lib/posts';

interface Props {
  post: CollectionEntry<'blog'>;
  allPosts: CollectionEntry<'blog'>[];
}

const { post, allPosts } = Astro.props;
const { title, description, pubDate, updatedDate, category, heroImage, heroImageAlt, affiliate, affiliateProduct } = post.data;
const cat = categories[category];
const minutes = readingTime(post.body);
const related = getRelatedPosts(post, allPosts);

const dateFormatter = new Intl.DateTimeFormat('pt-BR', { day: '2-digit', month: 'long', year: 'numeric' });
---

<BaseLayout title={title} description={description} image={heroImage} article={{ publishDate: pubDate, updatedDate }}>
  <div class="container post-layout">
    <article class="post-layout__main">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Início</a>
        <span aria-hidden="true">/</span>
        <a href={`/categoria/${cat.slug}/`}>{cat.label}</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{title}</span>
      </nav>

      <span class={`badge badge-${category}`}>{cat.label}</span>
      <h1>{title}</h1>
      <p class="post-layout__meta">
        Publicado em {dateFormatter.format(pubDate)}
        {updatedDate && <> · atualizado em {dateFormatter.format(updatedDate)}</>}
        · {minutes} min de leitura
      </p>

      {heroImage && <img class="post-layout__hero" src={heroImage} alt={heroImageAlt ?? title} />}

      <div class="post-layout__content">
        <slot />
      </div>

      {
        affiliate && affiliateProduct && (
          <AffiliateBox
            productName={affiliateProduct.name}
            productImage={affiliateProduct.image}
            store={affiliateProduct.store}
            url={affiliateProduct.url}
            price={affiliateProduct.price}
            note={affiliateProduct.note}
            postSlug={post.slug}
          />
        )
      }

      {
        related.length > 0 && (
          <section class="related" aria-labelledby="related-title">
            <h2 id="related-title" class="related__title">Leia também</h2>
            <div class="related__grid">
              {related.map((p) => (
                <PostCard post={p} variant="secondary" />
              ))}
            </div>
          </section>
        )
      }
    </article>

    <Sidebar posts={allPosts} />
  </div>
</BaseLayout>

<script is:inline>
  // Medição de cliques em links de afiliado. Só dispara se o gtag existir na página; caso contrário, não faz nada.
  document.addEventListener('click', function (event) {
    var link = event.target instanceof Element && event.target.closest('a[data-affiliate="true"]');
    if (!link || typeof window.gtag !== 'function') return;
    window.gtag('event', 'affiliate_click', {
      product: link.dataset.product,
      post: link.dataset.post,
      link_url: link.href,
    });
  });
</script>

<style>
  .post-layout {
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: 2.5rem;
    padding-block: 2.5rem;
    align-items: start;
  }

  .post-layout__main {
    /* Permite que o item do grid encolha; sem isso, conteúdo largo (ex.: tabelas) estoura a página no mobile */
    min-width: 0;
    background: var(--color-card-bg);
    border: 1px solid var(--color-card-border);
    border-radius: var(--radius);
    padding: 2rem 2.25rem;
  }

  .breadcrumb {
    font-size: 0.85rem;
    color: #5c6b60;
    margin-bottom: 1rem;
    display: flex;
    gap: 0.5em;
    flex-wrap: wrap;
  }

  .breadcrumb a {
    color: #5c6b60;
  }

  .post-layout__meta {
    color: #6b7a72;
    font-size: 0.9rem;
    margin-top: 0.75em;
  }

  .post-layout__hero {
    width: 100%;
    border-radius: var(--radius);
    margin: 1.5rem 0;
  }

  .post-layout__content {
    font-size: 1.05rem;
  }

  .post-layout__content :global(h2) {
    margin-top: 1.75em;
  }

  .post-layout__content :global(h3) {
    margin-top: 1.4em;
  }

  .post-layout__content :global(a) {
    color: var(--color-green-dark);
    text-decoration: underline;
  }

  .post-layout__content :global(a.affiliate-box__cta) {
    color: #fff;
    text-decoration: none;
  }

  .post-layout__content :global(blockquote) {
    margin: 1.5em 0;
    padding: 0.9em 1.25em;
    background: var(--color-green-light);
    border-left: 4px solid var(--color-green);
    border-radius: 0 8px 8px 0;
    color: var(--color-green-dark);
  }

  .post-layout__content :global(blockquote p:last-child) {
    margin-bottom: 0;
  }

  .post-layout__content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.75em 0;
    font-size: 0.97rem;
    border-radius: var(--radius);
    /* Borda externa via box-shadow: com border-collapse, border + border-radius não arredonda os cantos */
    box-shadow: 0 0 0 1px var(--color-card-border);
    overflow: hidden;
  }

  .post-layout__content :global(tr) {
    border-bottom: 1px solid var(--color-card-border);
  }

  .post-layout__content :global(tbody tr:last-child) {
    border-bottom: none;
  }

  .post-layout__content :global(th),
  .post-layout__content :global(td) {
    padding: 0.75rem 1rem;
    text-align: left;
    vertical-align: top;
  }

  .post-layout__content :global(thead th) {
    background: var(--color-green-light);
    color: var(--color-green-dark);
    font-family: var(--font-heading);
    font-weight: 600;
  }

  .post-layout__content :global(tbody tr:nth-child(even)) {
    background: var(--color-bg);
  }

  .post-layout__content :global(tbody td:first-child) {
    font-weight: 700;
  }

  .related {
    margin-top: 2.5rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--color-card-border);
  }

  .related__title {
    font-size: 1.3rem;
    margin-bottom: 1rem;
  }

  .related__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  @media (max-width: 860px) {
    .post-layout {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .related__grid {
      grid-template-columns: 1fr;
    }

    .post-layout__content :global(table) {
      display: block;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }
  }
</style>
