---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';
import AffiliateBox from '../components/AffiliateBox.astro';
import { categories } from '../lib/categories';
import { readingTime } from '../lib/reading-time';

interface Props {
  post: CollectionEntry<'blog'>;
  allPosts: CollectionEntry<'blog'>[];
}

const { post, allPosts } = Astro.props;
const { title, description, pubDate, updatedDate, category, heroImage, affiliate, affiliateProduct } = post.data;
const cat = categories[category];
const minutes = readingTime(post.body);

const dateFormatter = new Intl.DateTimeFormat('pt-BR', { day: '2-digit', month: 'long', year: 'numeric' });
---

<BaseLayout title={title} description={description} image={heroImage} article={{ publishDate: pubDate, updatedDate }}>
  <div class="container post-layout">
    <Sidebar posts={allPosts} />

    <article class="post-layout__main">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Início</a>
        <span aria-hidden="true">/</span>
        <a href={`/categoria/${cat.slug}/`}>{cat.label}</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{title}</span>
      </nav>

      <span class={`badge badge-${category}`}>{cat.label}</span>
      <h1>{title}</h1>
      <p class="post-layout__meta">
        Publicado em {dateFormatter.format(pubDate)}
        {updatedDate && <> · atualizado em {dateFormatter.format(updatedDate)}</>}
        · {minutes} min de leitura
      </p>

      {heroImage && <img class="post-layout__hero" src={heroImage} alt={title} />}

      <div class="post-layout__content">
        <slot />
      </div>

      {
        affiliate && affiliateProduct && (
          <AffiliateBox
            productName={affiliateProduct.name}
            productImage={affiliateProduct.image}
            store={affiliateProduct.store}
            url={affiliateProduct.url}
            price={affiliateProduct.price}
            note={affiliateProduct.note}
          />
        )
      }
    </article>
  </div>
</BaseLayout>

<style>
  .post-layout {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 2.5rem;
    padding-block: 2.5rem;
    align-items: start;
  }

  .post-layout__main {
    background: var(--color-card-bg);
    border: 1px solid var(--color-card-border);
    border-radius: var(--radius);
    padding: 2rem 2.25rem;
  }

  .breadcrumb {
    font-size: 0.85rem;
    color: #5c6b60;
    margin-bottom: 1rem;
    display: flex;
    gap: 0.5em;
    flex-wrap: wrap;
  }

  .breadcrumb a {
    color: #5c6b60;
  }

  .post-layout__meta {
    color: #6b7a72;
    font-size: 0.9rem;
    margin-top: 0.75em;
  }

  .post-layout__hero {
    width: 100%;
    border-radius: var(--radius);
    margin: 1.5rem 0;
  }

  .post-layout__content {
    font-size: 1.05rem;
  }

  .post-layout__content :global(h2) {
    margin-top: 1.75em;
  }

  .post-layout__content :global(h3) {
    margin-top: 1.4em;
  }

  .post-layout__content :global(a) {
    color: var(--color-green-dark);
    text-decoration: underline;
  }

  .post-layout__content :global(blockquote) {
    margin: 1.5em 0;
    padding: 0.9em 1.25em;
    background: var(--color-green-light);
    border-left: 4px solid var(--color-green);
    border-radius: 0 8px 8px 0;
    color: var(--color-green-dark);
  }

  .post-layout__content :global(blockquote p:last-child) {
    margin-bottom: 0;
  }

  @media (max-width: 860px) {
    .post-layout {
      grid-template-columns: 1fr;
    }
  }
</style>
